{
  "dns": {
    "hosts": {
      "lkfl2.nalog.ru": "213.24.64.175",
      "lknpd.nalog.ru": "213.24.64.181"
    },
    "servers": [
      {
        "address": "77.88.8.8",
        "domains": [
          "geosite:category-ru",
          "geosite:private"
        ]
      },
      {
        "address": "localhost",
        "domains": "__OWN_DOMAINS__"
      },
      "https://1.1.1.1/dns-query",
      "8.8.8.8"
    ],
    "queryStrategy": "UseIPv4"
  },
  "log": {
    "loglevel": "warning"
  },
  "policy": {
    "levels": {
      "8": {
        "connIdle": 300,
        "handshake": 4,
        "uplinkOnly": 2,
        "downlinkOnly": 5
      }
    }
  },
  "routing": {
    "rules": [
      {
        "port": 53,
        "type": "field",
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "domain": "__OWN_DOMAINS__",
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "domain:oneme.ru",
          "domain:max.ru"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "domain": [
          "geosite:category-ads"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "domain": [
          "domain:tbank.ru",
          "domain:tinkoff.ru",
          "domain:t-bank-app.ru",
          "domain:sberbank.ru",
          "domain:vtb.ru",
          "domain:alfabank.ru",
          "domain:raiffeisen.ru",
          "domain:gazprombank.ru",
          "domain:rosbank.ru",
          "domain:otpbank.ru",
          "domain:pochtabank.ru",
          "domain:sovcombank.ru"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "domain:avito.st",
          "geosite:category-ru",
          "regexp:.*\\.ru$",
          "regexp:.*\\.xn--p1ai$",
          "regexp:.*\\.xn--p1acf$"
        ],
        "outboundTag": "direct"
      },
      {
        "ip": [
          "geoip:private",
          "geoip:ru"
        ],
        "type": "field",
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "geosite:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ],
    "domainMatcher": "hybrid",
    "domainStrategy": "IPIfNonMatch"
  },
  "inbounds": [
    {
      "tag": "socks",
      "port": 10808,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "udp": true,
        "auth": "noauth"
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": false,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "http",
      "port": 10809,
      "listen": "127.0.0.1",
      "protocol": "http",
      "settings": {
        "allowTransparent": false
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": false,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    },
    {
      "tag": "dns-out",
      "protocol": "dns"
    }
  ],
  "remnawave": {
    "addVirtualHostAsOutbound": true
  },
  "burstObservatory": {
    "pingConfig": {
      "timeout": "3s",
      "interval": "60m",
      "sampling": 2,
      "destination": "https://www.gstatic.com/generate_204"
    },
    "subjectSelector": [
      "proxy"
    ]
  }
}
