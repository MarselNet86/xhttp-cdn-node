# cdn-deploy configuration contract (tech.md §4). Keep keys, order and defaults in sync.
#
# ./deploy.sh asks for every value and writes .env with mode 600 (it holds CF_API_TOKEN).
# Values from an existing .env become the defaults on the next run, so copying this file
# to .env and filling it in pre-answers the questions.
#
# Format: KEY=value, one per line. Values are literal: no $ expansion, no escapes.
# Quote values with spaces; " #" after an unquoted value starts a comment.

# Optional. FQDN of this server for direct VLESS connections, an A record here. Empty on a
# server that already runs VLESS: no certificate is issued for it. Required under
# CERT_MODE=http-01 or ISSUE_CDN_ORIGIN_CERT=false, where its certificate serves origin nginx.
VLESS_DOMAIN=

# Optional. FQDN of the Hysteria2 inbound whose certificate this script issues and renews.
# Empty when the server manages that certificate itself: no certificate, no node restart.
HY2_DOMAIN=

# Required. FQDN of the CDN resource: origin server_name, xhttp host, checker target.
CDN_DOMAIN=

# Required. Public IPv4 of this server, the origin of the CDN resource.
# Autodetected with `curl -4 ifconfig.me`, then confirmed.
ORIGIN_IP=

# Local port of the xray xhttp inbound, 1-65535.
XHTTP_PORT=4443

# xhttp path: starts and ends with "/", identical in the inbound and the host config.
# Keep it short with a dot in a segment: Timeweb CDN reportedly returns 403 on long
# URLs and forwards only such paths to origin.
XHTTP_PATH=/api/v2.jpg/

# Port of origin nginx that the CDN edge connects to, 1-65535.
NGINX_TLS_PORT=8444

# Certificate issuance: dns-cloudflare | http-01.
# http-01 cannot validate CDN_DOMAIN (a CNAME to the CDN) and forces ISSUE_CDN_ORIGIN_CERT=false.
CERT_MODE=dns-cloudflare

# Required when CERT_MODE=dns-cloudflare: Cloudflare API token with Zone:DNS:Edit on the zone.
CF_API_TOKEN=

# Let's Encrypt contact email. Empty registers without an email.
LE_EMAIL=

# Restarts the node in the renewal hook so it picks up the renewed Hysteria2 certificate.
# Used only with HY2_DOMAIN. remnanode is the container name of the official node install.
NODE_RELOAD_CMD="docker restart remnanode"

# true | false. Issue an origin certificate for CDN_DOMAIN; with false, origin nginx
# reuses the VLESS_DOMAIN certificate.
ISSUE_CDN_ORIGIN_CERT=true

# Site that the VLESS Reality inbound of the generated config profile impersonates: TLS 1.3
# with h2, close to this server, reachable from Russia. - for a profile without Reality.
REALITY_SNI=www.swiss.com

# Reality x25519 private key, base64url. Generated when empty and kept here, so a rerun
# does not break the clients.
REALITY_PRIVATE_KEY=

# Reality short id: 2 to 16 hex digits. Generated when empty.
REALITY_SHORT_ID=
